  storageLimit   Float   @default(10) // GB
  accountsLimit  Int     @default(3)
  teamSeatsLimit Int     @default(1)
  whiteLabelEnabled Boolean @default(false)
  customDomain  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
  clients      Client[]
  socialAccounts SocialAccount[]
  invoices     Invoice[]

  @@map("companies")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENCY_MANAGER
  MARKETING_DIRECTOR
  SOCIAL_MANAGER
  SEO_SPECIALIST
  CONTENT_CREATOR
  SALES_REP
  EMAIL_MARKETER
  VIEWER
  CUSTOM
}

enum UserStatus { ACTIVE SUSPENDED DELETED }
